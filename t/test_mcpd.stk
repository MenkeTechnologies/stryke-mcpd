## t/test_mcpd.stk — assertion tests for the stryke-mcpd package.
##
## Headless-CI safe: the round trip serves a generated server script
## over stdio on this same machine — no network, no external MCP
## server. Schema / Tools / Client helpers are asserted as pure fns.

use Mcpd

# ── version / modules ────────────────────────────────────────────────
assert_match qr/^\d+\.\d+\.\d+$/, Mcpd::version(), "Mcpd::version is semver"
assert_eq scalar(Mcpd::modules()), 4, "Mcpd::modules lists four sublibs"

# ── Schema::tool ─────────────────────────────────────────────────────
val $spec = Mcpd::Schema::tool("add", "Add", +{ a => "number", b => "number" }, fn { 1 })
assert_eq $spec->{name}, "add",                    "tool spec keeps name"
assert_eq ref($spec->{run}), "CODE",               "tool spec keeps run coderef"
assert_eq scalar(Mcpd::Schema::types()), 5,        "five wire types"
assert_dies fn { Mcpd::Schema::tool("9bad", "d", +{}, fn { 1 }) },        "tool rejects non-identifier name"
assert_dies fn { Mcpd::Schema::tool("x", "", +{}, fn { 1 }) },            "tool rejects empty description"
assert_dies fn { Mcpd::Schema::tool("x", "d", +{ a => "float" }, fn { 1 }) }, "tool rejects unknown param type"
assert_dies fn { Mcpd::Schema::tool("x", "d", +{}, "not-code") },          "tool rejects non-coderef run"

# ── Schema::check_args ───────────────────────────────────────────────
assert_eq Mcpd::Schema::check_args($spec, +{ a => 1, b => 2 }), 1, "check_args accepts full args"
assert_dies fn { Mcpd::Schema::check_args($spec, +{ a => 1 }) },             "check_args rejects missing param"
assert_dies fn { Mcpd::Schema::check_args($spec, +{ a => 1, b => "x" }) },   "check_args rejects non-number"
assert_dies fn { Mcpd::Schema::check_args($spec, +{ a => 1, b => 2, c => 3 }) }, "check_args rejects extras"

# ── Schema::validate_all ─────────────────────────────────────────────
assert_eq Mcpd::Schema::validate_all([$spec]), 1, "validate_all counts tools"
assert_dies fn { Mcpd::Schema::validate_all("x") },        "validate_all rejects non-arrayref"
assert_dies fn { Mcpd::Schema::validate_all([$spec, $spec]) }, "validate_all rejects duplicate names"
assert_dies fn { Mcpd::Schema::validate_all([+{ name => "x" }]) }, "validate_all rejects partial spec"

# ── Schema::param_names / tool_summary / describe / rename ───────────
val $sp2 = Mcpd::Schema::tool("add", "Add two numbers", +{ b => "number", a => "number" }, fn { 1 })
assert_eq join(",", @{ Mcpd::Schema::param_names($sp2) }), "a,b", "param_names sorted"
assert_eq scalar(@{ Mcpd::Schema::param_names(Mcpd::Schema::tool("nop", "d", +{}, fn { 1 })) }), 0, "param_names empty"
assert_eq Mcpd::Schema::tool_summary($sp2), "add(a:number, b:number) - Add two numbers", "tool_summary signature"
val $cat = Mcpd::Schema::describe([$sp2, Mcpd::Schema::tool("ping", "Ping", +{}, fn { 1 })])
assert_match qr/add\(a:number, b:number\) - Add two numbers/, $cat, "describe lists first tool"
assert_match qr/ping\(\) - Ping/,                            $cat, "describe lists second tool"
assert_dies fn { Mcpd::Schema::describe("nope") }, "describe validates the set"
val $rn = Mcpd::Schema::rename($sp2, "plus")
assert_eq $rn->{name},        "plus",            "rename swaps name"
assert_eq $rn->{description},  "Add two numbers", "rename preserves description"
assert_eq ref($rn->{run}),    "CODE",            "rename preserves run coderef"
assert_eq join(",", @{ Mcpd::Schema::param_names($rn) }), "a,b", "rename preserves parameters"
assert_dies fn { Mcpd::Schema::rename($sp2, "9bad") }, "rename re-validates the new name"

# ── Schema::to_json_schema (MCP inputSchema wire format) ──────────────
val $js = Mcpd::Schema::to_json_schema($sp2)
assert_eq $js->{type},                       "object",   "to_json_schema: object type"
assert_eq $js->{properties}{a}{type},        "number",   "to_json_schema: per-param type"
assert_eq $js->{properties}{b}{type},        "number",   "to_json_schema: second param"
assert_eq join(",", @{ $js->{required} }),   "a,b",      "to_json_schema: all params required, sorted"
val $js0 = Mcpd::Schema::to_json_schema(Mcpd::Schema::tool("nop", "d", +{}, fn { 1 }))
assert_eq scalar(@{ $js0->{required} }),     0,          "to_json_schema: no params → empty required"
assert_eq scalar(keys %{ $js0->{properties} }), 0,       "to_json_schema: no params → empty properties"

# ── Server::wrap error envelope ──────────────────────────────────────
val $ok_run  = Mcpd::Server::wrap("t1", fn { "fine" })
val $bad_run = Mcpd::Server::wrap("t2", fn { die "boom" })
assert_eq $ok_run->(),  "fine",          "wrap passes results through"
assert_match qr/^ERROR: boom/, $bad_run->(), "wrap converts die to ERROR envelope"
# the stryke die location (" at FILE line N.") is stripped from the envelope
val $loc_run = Mcpd::Server::wrap("t3", fn { die "bad thing happened" })
assert_eq $loc_run->(), "ERROR: bad thing happened", "wrap strips the die location suffix"

# ── Server::log_to file logging ──────────────────────────────────────
val $logf = "/tmp/mcpd-test-$$.log"
Mcpd::Server::log_to($logf)
Mcpd::Server::log("hello-log")
assert_match qr/hello-log/, slurp($logf), "log appends to configured file"
assert_eq Mcpd::Server::log_path(), $logf, "log_path returns configured path"

# ── Server::wrap_all (pins BUG-305 spread fix) ───────────────────────
val $raw = [ Mcpd::Schema::tool("ok", "Fine", +{ x => "number" }, fn { "fine" }),
             Mcpd::Schema::tool("boom", "Dies", +{}, fn { die "kab" }) ]
val $wa = Mcpd::Server::wrap_all($raw)
assert_eq scalar(@$wa), 2,             "wrap_all returns one spec per tool"
assert_eq $wa->[0]{name}, "ok",        "wrap_all preserves name"
assert_eq $wa->[0]{description}, "Fine","wrap_all preserves description"
assert_eq join(",", @{ Mcpd::Schema::param_names($wa->[0]) }), "x", "wrap_all preserves parameters"
assert_eq $wa->[0]{run}->(),  "fine",  "wrap_all run passes through"
assert_match qr/^ERROR: kab/, $wa->[1]{run}->(), "wrap_all wraps the dying tool"

# ── Server::audit logs successful calls ──────────────────────────────
Mcpd::Server::log("hello-log")  # ensure path still set
val $aud = Mcpd::Server::audit("calc", fn { "1234" })
assert_eq $aud->(), "1234",            "audit passes result through"
assert_match qr/tool calc ok: 4 bytes/, slurp($logf), "audit logs success with byte count"
unlink $logf

# ── Tools::jail ──────────────────────────────────────────────────────
assert_eq Mcpd::Tools::jail("/srv/data", "a/b.txt"),    "/srv/data/a/b.txt", "jail resolves relative"
assert_eq Mcpd::Tools::jail("/srv/data", "a/../b.txt"), "/srv/data/b.txt",   "jail collapses dotdot inside"
assert_dies fn { Mcpd::Tools::jail("/srv/data", "../../etc/passwd") }, "jail blocks dotdot escape"
assert_dies fn { Mcpd::Tools::jail("/srv/data", "/etc/passwd") },      "jail blocks absolute escape"

# ── Tools specs are well-formed ──────────────────────────────────────
val $pack = Mcpd::Tools::all(+{ root => "/tmp" })
assert_eq Mcpd::Schema::validate_all($pack), 16,   "stock pack is 16 valid tools"
assert_eq scalar(Mcpd::Tools::names()), 16,        "stock roster pinned at 16"

val $ro_pack = Mcpd::Tools::all(+{ root => "/tmp", readonly => 1 })
assert_eq Mcpd::Schema::validate_all($ro_pack), 12, "readonly pack drops 4 mutating tools"
val %ro_names = map { $_->{name} => 1 } @$ro_pack
assert_ok !$ro_names{fs_write},                    "readonly pack has no fs_write"
assert_ok !$ro_names{fs_append},                   "readonly pack has no fs_append"
assert_ok !$ro_names{fs_mkdir},                    "readonly pack has no fs_mkdir"
assert_ok !$ro_names{sh_exec},                     "readonly pack has no sh_exec"
assert_ok  $ro_names{fs_read},                     "readonly pack keeps fs_read"
assert_ok  $ro_names{fs_tail},                     "readonly pack keeps fs_tail"
assert_ok  $ro_names{fs_lines},                    "readonly pack keeps fs_lines"
val $read_spec = Mcpd::Tools::fs_read(+{ root => "/tmp" })
val $tmp_file = "/tmp/mcpd-fsread-$$.txt"
spurt($tmp_file, "jail-read-ok")
assert_eq $read_spec->{run}->(+{ path => "mcpd-fsread-$$.txt" }), "jail-read-ok", "fs_read reads inside jail"
unlink $tmp_file
val $exec_spec = Mcpd::Tools::sh_exec(+{ allow => ["echo"] })
assert_match qr/allowed/, $exec_spec->{run}->(+{ command => "echo allowed" }), "sh_exec runs allowlisted command"
assert_dies fn { $exec_spec->{run}->(+{ command => "rm -rf /" }) }, "sh_exec blocks non-allowlisted command"

# ── Tools: fs_list run path (pins the glob-not-opendir fix) ──────────
val $list_dir = "/tmp/mcpd-list-$$"
mkdir $list_dir
spurt("$list_dir/b.txt", "x")
spurt("$list_dir/a.txt", "x")
spurt("$list_dir/.hidden", "x")
val $list_spec = Mcpd::Tools::fs_list(+{ root => $list_dir })
assert_eq $list_spec->{run}->(+{ path => "." }), ".hidden\na.txt\nb.txt", "fs_list sorted incl dotfiles, no . or .."
assert_dies fn { $list_spec->{run}->(+{ path => "a.txt" }) }, "fs_list dies on non-dir"
unlink "$list_dir/a.txt"
unlink "$list_dir/b.txt"
unlink "$list_dir/.hidden"
rmdir $list_dir

# ── Tools: fs_grep run path (pins the qr// subscript-hoist fix) ──────
val $grep_dir = "/tmp/mcpd-grep-$$"
mkdir $grep_dir
spurt("$grep_dir/log.txt", "ok line\nERROR bad\nok again")
val $grep_spec = Mcpd::Tools::fs_grep(+{ root => $grep_dir })
assert_eq $grep_spec->{run}->(+{ path => "log.txt", pattern => "^ERROR" }), "ERROR bad", "fs_grep matches pattern param"
unlink "$grep_dir/log.txt"
rmdir $grep_dir

# ── Tools: fs_write / fs_stat / fs_find ──────────────────────────────
val $jail_dir = "/tmp/mcpd-tools-$$"
mkdir $jail_dir
mkdir "$jail_dir/sub"
val $write_spec = Mcpd::Tools::fs_write(+{ root => $jail_dir })
assert_match qr/wrote 8 bytes/, $write_spec->{run}->(+{ path => "out.txt", content => "payload!" }), "fs_write reports byte receipt"
assert_eq slurp("$jail_dir/out.txt"), "payload!",  "fs_write lands inside jail"
assert_dies fn { $write_spec->{run}->(+{ path => "../escape.txt", content => "x" }) }, "fs_write blocks jail escape"

val $stat_spec = Mcpd::Tools::fs_stat(+{ root => $jail_dir })
val $stat_out = $stat_spec->{run}->(+{ path => "out.txt" })
assert_match qr/type: file/,  $stat_out, "fs_stat reports file type"
assert_match qr/size: 8/,     $stat_out, "fs_stat reports size"
assert_match qr/mtime: \d+/,  $stat_out, "fs_stat reports mtime"
assert_match qr/type: dir/, $stat_spec->{run}->(+{ path => "sub" }), "fs_stat reports dir type"
assert_dies fn { $stat_spec->{run}->(+{ path => "missing.txt" }) }, "fs_stat dies on missing path"

spurt("$jail_dir/sub/deep.log", "x")
val $find_spec = Mcpd::Tools::fs_find(+{ root => $jail_dir })
val $found = $find_spec->{run}->(+{ path => ".", pattern => "\\.log\$" })
assert_match qr{sub/deep\.log}, $found, "fs_find recurses into subdirs"
assert_eq $find_spec->{run}->(+{ path => ".", pattern => "nomatch" }), "", "fs_find empty on no match"
assert_dies fn { $find_spec->{run}->(+{ path => "out.txt", pattern => "x" }) }, "fs_find dies on non-dir start"
val $shallow_spec = Mcpd::Tools::fs_find(+{ root => $jail_dir, max_depth => 1 })
assert_ok $shallow_spec->{run}->(+{ path => ".", pattern => "deep" }) !~ /deep/, "fs_find honors max_depth"
unlink "$jail_dir/sub/deep.log"
unlink "$jail_dir/out.txt"
rmdir "$jail_dir/sub"
rmdir $jail_dir

# ── Client envelope helpers (pure) ───────────────────────────────────
val $env = +{ content => [ +{ type => "text", text => "4" }, +{ type => "text", text => "2" } ] }
assert_eq Mcpd::Client::text($env), "42",          "text joins text blocks"
assert_eq Mcpd::Client::text(+{}), "",             "text empty on missing content"
assert_ok Mcpd::Client::is_error(+{ content => [ +{ type => "text", text => "ERROR: x" } ] }),
                                                   "is_error detects envelope"
assert_ok !Mcpd::Client::is_error($env),           "is_error passes clean results"

val $multi = +{ content => [ +{ type => "text", text => "a" }, +{ type => "image", url => "x" }, +{ type => "text", text => "b" } ] }
assert_eq join(",", @{ Mcpd::Client::texts($multi) }), "a,b",   "texts returns unjoined text blocks"
assert_eq scalar(@{ Mcpd::Client::texts(+{}) }),       0,       "texts empty on missing content"
assert_eq join(",", @{ Mcpd::Client::content_types($multi) }), "image,text", "content_types distinct + sorted"
assert_eq scalar(@{ Mcpd::Client::content_types(+{}) }),       0,            "content_types empty on missing content"

val $errenv = +{ content => [ +{ type => "text", text => "ERROR: boom happened" } ] }
assert_eq Mcpd::Client::error_message($errenv), "boom happened", "error_message strips prefix"
assert_ok !defined Mcpd::Client::error_message($env), "error_message undef on clean result"

# ── Round trip: serve + connect over stdio ───────────────────────────
val $srv = "/tmp/mcpd-test-server-$$.stk"
spurt($srv, q{use Mcpd
Mcpd::Server::serve("t", [
    Mcpd::Schema::tool("add", "Add", +{ a => "number", b => "number" },
        fn { val $a = shift; $a->{a} + $a->{b} }),
    Mcpd::Schema::tool("kaboom", "Dies", +{}, fn { die "kaboom" }),
])
})
val $h = mcp_connect("stdio:stryke $srv")
assert_eq join(",", @{ Mcpd::Client::tool_names($h) }), "add,kaboom", "round trip lists tools"
assert_ok  Mcpd::Client::has_tool($h, "add"),     "has_tool finds exposed tool"
assert_ok !Mcpd::Client::has_tool($h, "nope"),    "has_tool rejects absent tool"
assert_eq Mcpd::Client::call_text($h, "add", +{ a => 2, b => 40 }), "42", "round trip calls tool"
assert_ok Mcpd::Client::is_error(mcp_call($h, "kaboom", +{})), "dying tool returns error envelope"
assert_eq Mcpd::Client::call_text($h, "add", +{ a => 1, b => 1 }), "2", "server survives dying tool"
mcp_close($h)
unlink $srv

# ── Integration: stock pack + custom tool served live over stdio ─────
# The stock fs tools are unit-tested as specs above (run coderefs called
# directly); this drives them through a real mcp_connect round trip and
# proves the jail holds over the wire.
val $jail = "/tmp/mcpd-int-$$"
mkdir $jail
$ENV{MCPD_JAIL} = $jail
val $isrv = "/tmp/mcpd-int-server-$$.stk"
spurt($isrv, q{use Mcpd
val $root = $ENV{MCPD_JAIL}
Mcpd::Server::serve("stockint", [
    @{ Mcpd::Tools::all(+{ root => $root }) },
    Mcpd::Schema::tool("greet", "Greet someone", +{ who => "string" },
        fn { val $a = shift; "hi " . $a->{who} }),
])
})
val $ih = mcp_connect("stdio:stryke $isrv")
assert_ok Mcpd::Client::has_tool($ih, "fs_write"),  "integration: stock fs_write exposed live"
assert_ok Mcpd::Client::has_tool($ih, "fs_read"),   "integration: stock fs_read exposed live"
assert_ok Mcpd::Client::has_tool($ih, "greet"),     "integration: custom tool composed with stock pack"
assert_eq scalar(@{ Mcpd::Client::tool_names($ih) }), 17, "integration: 16 stock + 1 custom tool"
# write then read back through the live jailed server
Mcpd::Client::call_text($ih, "fs_write", +{ path => "note.txt", content => "live-jailed" })
assert_eq slurp("$jail/note.txt"), "live-jailed", "integration: fs_write landed inside the jail"
assert_eq Mcpd::Client::call_text($ih, "fs_read", +{ path => "note.txt" }), "live-jailed", "integration: fs_read round-trips over the wire"
assert_eq Mcpd::Client::call_text($ih, "greet", +{ who => "stryke" }), "hi stryke", "integration: custom tool runs over the wire"
# a jail escape comes back as an error envelope, unwrapped by error_message
val $esc = mcp_call($ih, "fs_read", +{ path => "../../etc/passwd" })
assert_ok Mcpd::Client::is_error($esc), "integration: jail escape returns an error envelope"
assert_eq Mcpd::Client::error_message($esc), "path escapes root: ../../etc/passwd", "integration: error_message unwraps the jail violation (no die location)"
mcp_close($ih)
unlink "$jail/note.txt"
rmdir $jail
unlink $isrv

# ── v0.6.0 stock tools (handler-level, real files under a temp jail) ──
val $troot = "/tmp/mcpd-tools-$$"
mkdir $troot
spurt("$troot/log.txt", "l1\nl2\nl3\nl4\nl5")

# fs_tail
val $tail = Mcpd::Tools::fs_tail(+{ root => $troot })
assert_eq $tail->{run}->(+{ path => "log.txt", lines => 2 }), "l4\nl5", "fs_tail returns last N lines"
assert_dies fn { $tail->{run}->(+{ path => "log.txt", lines => 0 }) }, "fs_tail rejects non-positive N"

# fs_exists
val $ex = Mcpd::Tools::fs_exists(+{ root => $troot })
assert_eq $ex->{run}->(+{ path => "log.txt" }), "file", "fs_exists reports file"
assert_eq $ex->{run}->(+{ path => "nope.txt" }), "missing", "fs_exists reports missing"

# fs_lines (wc): 5 content lines, 4 newlines → wc -l semantics = 4
val $wc = Mcpd::Tools::fs_lines(+{ root => $troot })
assert_match qr/lines: 4\n/, $wc->{run}->(+{ path => "log.txt" }), "fs_lines counts newlines (wc -l)"
assert_match qr/words: 5/,    $wc->{run}->(+{ path => "log.txt" }), "fs_lines counts words"

# fs_append creates then appends
val $app = Mcpd::Tools::fs_append(+{ root => $troot })
$app->{run}->(+{ path => "out.txt", content => "a" })
$app->{run}->(+{ path => "out.txt", content => "b" })
assert_eq slurp("$troot/out.txt"), "ab", "fs_append concatenates across calls"

# fs_mkdir
val $mk = Mcpd::Tools::fs_mkdir(+{ root => $troot })
assert_match qr/^created/, $mk->{run}->(+{ path => "sub" }), "fs_mkdir creates a dir"
val $sub_made = -d "$troot/sub" ? 1 : 0
assert_ok $sub_made, "fs_mkdir directory exists on disk"
assert_match qr/^exists/, $mk->{run}->(+{ path => "sub" }), "fs_mkdir is idempotent"

# jail still applies to the new tools
assert_dies fn { $app->{run}->(+{ path => "../escape.txt", content => "x" }) }, "fs_append honors the jail"
assert_dies fn { $mk->{run}->(+{ path => "/etc/evil" }) }, "fs_mkdir honors the jail"

unlink "$troot/log.txt"
unlink "$troot/out.txt"
rmdir "$troot/sub"
rmdir $troot

test_run
