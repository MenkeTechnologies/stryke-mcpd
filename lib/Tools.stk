## lib/Tools.stk — `use Mcpd::Tools`
##
## The stock tool pack: filesystem read/list/grep/find/stat/write,
## shell exec, and system info as ready-made specs. Every generator
## takes an opts hashref and returns a spec consumable by
## `Mcpd::Server::serve` — compose your server from stock + custom
## tools in one list. `all(+{readonly => 1})` drops the mutating
## tools (fs_write, sh_exec).
##
## Filesystem tools are root-jailed: paths resolve under opts root
## (default cwd) and escapes (`..`, absolute paths outside root) die —
## which the Server wrap turns into an ERROR result, not a dead server.

package Mcpd::Tools

use Mcpd::Schema

## Resolve PATH under ROOT and die if the result escapes it.
fn Mcpd::Tools::jail ($root, $path) {
    val $abs = $path =~ m{^/} ? $path : "$root/$path"
    # Lexical normalize: collapse //, resolve . and .. segments.
    var @out
    for my $seg (grep { length $_ && $_ ne "." } split "/", $abs) {
        if ($seg eq "..") {
            die "path escapes root: $path" unless @out
            pop @out
        } else {
            push @out, $seg
        }
    }
    val $norm = "/" . join("/", @out)
    val $jail = $root =~ m{^/} ? $root : "/" . $root
    unless ($norm eq $jail || index($norm, "$jail/") == 0) {
        die "path escapes root: $path"
    }
    $norm
}

## fs_read: return a file's contents. opts: root (jail, default cwd).
fn Mcpd::Tools::fs_read ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_read", "Read a file under $root",
        +{ path => "string" },
        fn {
            val $args = shift
            slurp Mcpd::Tools::jail($root, $args->{path})
        })
}

## fs_list: list a directory. opts: root (jail, default cwd).
fn Mcpd::Tools::fs_list ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_list", "List a directory under $root",
        +{ path => "string" },
        fn {
            val $args = shift
            val $dir = Mcpd::Tools::jail($root, $args->{path})
            die "cannot open dir: $dir" unless -d $dir
            # glob, not opendir: lexical dirhandles read empty inside
            # closures (strykelang bug, see BUGS.md upstream).
            val @entries = sort
                map  { basename($_) }
                grep { val $b = basename($_); $b ne "." && $b ne ".." }
                (glob("$dir/.*"), glob("$dir/*"))
            join("\n", @entries)
        })
}

## fs_grep: regex search a file, return matching lines. opts: root.
fn Mcpd::Tools::fs_grep ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_grep", "Regex-search a file under $root, return matching lines",
        +{ path => "string", pattern => "string" },
        fn {
            val $args = shift
            # No qr// here: a qr object built from a hashref-derived
            # string inside a closure mismatches (strykelang bug, see
            # BUGS.md upstream). Direct /$pat/ interpolation works.
            val $pat = $args->{pattern}
            val @lines = split "\n", slurp(Mcpd::Tools::jail($root, $args->{path}))
            join("\n", grep { /$pat/ } @lines)
        })
}

## fs_write: write content to a file under the jail. opts: root.
## Returns a byte-count receipt. Excluded from `all` in readonly mode.
fn Mcpd::Tools::fs_write ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_write", "Write a file under $root",
        +{ path => "string", content => "string" },
        fn {
            val $args = shift
            val $dest = Mcpd::Tools::jail($root, $args->{path})
            spurt($dest, $args->{content})
            "wrote " . length($args->{content}) . " bytes to $args->{path}"
        })
}

## fs_du: recursively total the byte size and file count under a path in the
## jail — the directory-size companion of fs_stat (single file). A single file
## reports its own size; a directory is walked breadth-first (symlinks not
## followed) summing regular-file sizes. opts: root, max_depth (default 20),
## max_files (cap, default 100000). Read-only.
fn Mcpd::Tools::fs_du ($opts = undef) {
    $opts //= +{}
    val $root  = $opts->{root} // getcwd()
    val $depth = $opts->{max_depth} // 20
    val $cap   = $opts->{max_files} // 100000
    Mcpd::Schema::tool("fs_du", "Recursively total the byte size and file count under a path in $root",
        +{ path => "string" },
        fn {
            val $args = shift
            val $start = Mcpd::Tools::jail($root, $args->{path})
            die "no such path: $args->{path}" unless -e $start
            unless (-d $start) {
                val @st = stat($start)
                return "bytes: $st[7]\nfiles: 1"
            }
            var $bytes = 0
            var $files = 0
            var @queue = ([$start, 0])
            while (@queue) {
                val $item = shift @queue
                val ($dir, $d) = @$item
                for my $full (sort (glob("$dir/.*"), glob("$dir/*"))) {
                    val $b = basename($full)
                    next if $b eq "." || $b eq ".."
                    if (-d $full && !-l $full) {
                        push @queue, [$full, $d + 1] if $d + 1 < $depth
                    } elsif (-f $full && !-l $full) {
                        val @st = stat($full)
                        $bytes += $st[7]
                        $files += 1
                    }
                }
                last if $files >= $cap
            }
            "bytes: $bytes\nfiles: $files"
        })
}

## fs_stat: type / size / mtime for a path under the jail. opts: root.
fn Mcpd::Tools::fs_stat ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_stat", "Stat a path under $root: type, size, mtime",
        +{ path => "string" },
        fn {
            val $args = shift
            val $p = Mcpd::Tools::jail($root, $args->{path})
            die "no such path: $args->{path}" unless -e $p
            val @st = stat($p)
            val $type = -d $p ? "dir" : -l $p ? "link" : "file"
            "type: $type\nsize: $st[7]\nmtime: $st[9]"
        })
}

## fs_find: recursive filename search under a jailed directory.
## Params: path (start dir), pattern (regex on the path relative to
## the start dir). opts: root, max_depth (default 10), max_results
## (default 1000) — both caps keep a runaway query from flooding the
## envelope.
fn Mcpd::Tools::fs_find ($opts = undef) {
    $opts //= +{}
    val $root  = $opts->{root} // getcwd()
    val $depth = $opts->{max_depth} // 10
    val $cap   = $opts->{max_results} // 1000
    Mcpd::Schema::tool("fs_find", "Recursively find files under $root whose relative path matches a regex",
        +{ path => "string", pattern => "string" },
        fn {
            val $args = shift
            val $start = Mcpd::Tools::jail($root, $args->{path})
            die "not a directory: $args->{path}" unless -d $start
            # Direct /$pat/ interpolation, not qr// — see fs_grep note.
            val $pat = $args->{pattern}
            var @hits
            var @queue = ([$start, 0])
            while (@queue && @hits < $cap) {
                val $item = shift @queue
                val ($dir, $d) = @$item
                # glob, not opendir — see fs_list note.
                for my $full (sort (glob("$dir/.*"), glob("$dir/*"))) {
                    val $b = basename($full)
                    next if $b eq "." || $b eq ".."
                    val $rel = substr($full, length($start) + 1)
                    push @hits, $rel if $rel =~ /$pat/
                    last if @hits >= $cap
                    push @queue, [$full, $d + 1] if -d $full && !-l $full && $d + 1 < $depth
                }
            }
            join("\n", @hits)
        })
}

## sh_exec: run a shell command, return its output. opts: allow — an
## arrayref of permitted command words; omitted means any command.
fn Mcpd::Tools::sh_exec ($opts = undef) {
    $opts //= +{}
    val $allow = $opts->{allow}
    Mcpd::Schema::tool("sh_exec", "Run a shell command and return its output",
        +{ command => "string" },
        fn {
            val $args = shift
            val $cmd  = $args->{command}
            if (defined $allow) {
                val ($word) = $cmd =~ /^\s*(\S+)/
                val %ok = map { $_ => 1 } @$allow
                die "command `" . ($word // "") . "` not in allowlist" unless $ok{ $word // "" }
            }
            scalar qx($cmd)
        })
}

## sys_info: report platform basics — no params.
fn Mcpd::Tools::sys_info {
    Mcpd::Schema::tool("sys_info", "Report hostname, OS, and stryke version",
        +{},
        fn {
            "host: "   . (hostname_str() // "?") . "\n" .
            "os: $^O\n" .
            "pid: $$\n" .
            "cwd: " . getcwd()
        })
}

## The full stock pack as one list. opts forwarded to each generator.
## opts readonly => 1 drops the mutating tools (fs_write, sh_exec) —
## the safe default for servers that only need to answer questions.
## First $lines lines of a file under $root (a sandboxed `head`).
fn Mcpd::Tools::fs_head ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_head", "Read the first N lines of a file under $root",
        +{ path => "string", lines => "number" },
        fn {
            val $args = shift
            val $n = int($args->{lines})
            die "lines must be positive" if $n <= 0
            val @lines = split(/\n/, slurp(Mcpd::Tools::jail($root, $args->{path})))
            val $end = $#lines < $n - 1 ? $#lines : $n - 1
            $end < 0 ? "" : join("\n", @lines[0 .. $end])
        })
}

## fs_slice: read a 1-based inclusive line range [start..end] of a file under
## $root — the middle-of-file companion of fs_head/fs_tail, for reading context
## around a grep hit without slurping the whole file. Params: path, start, end.
## end past EOF clamps to the last line; start past EOF yields "". Read-only.
fn Mcpd::Tools::fs_slice ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_slice", "Read lines [start..end] (1-based, inclusive) of a file under $root",
        +{ path => "string", start => "number", end => "number" },
        fn {
            val $args  = shift
            val $start = int($args->{start})
            val $end   = int($args->{end})
            die "start must be positive" if $start <= 0
            die "end must be >= start" if $end < $start
            val @lines = split(/\n/, slurp(Mcpd::Tools::jail($root, $args->{path})))
            val $count = scalar(@lines)
            val $hi = $end > $count ? $count : $end
            $start > $count ? "" : join("\n", @lines[$start - 1 .. $hi - 1])
        })
}

## fs_hash: checksum a file under $root — for verifying integrity or detecting a
## change without re-reading the whole file content into the model. Params: path,
## algorithm (sha256 default, or sha1 / md5 / crc32). Read-only.
fn Mcpd::Tools::fs_hash ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_hash", "Checksum a file under $root (algorithm: sha256 [default], sha1, md5, crc32)",
        +{ path => "string", algorithm => "string" },
        fn {
            val $args = shift
            val $algo = $args->{algorithm} // "sha256"
            val $data = slurp(Mcpd::Tools::jail($root, $args->{path}))
            val $digest =
                $algo eq "sha256" ? sha256($data)
              : $algo eq "sha1"   ? sha1($data)
              : $algo eq "md5"    ? md5($data)
              : $algo eq "crc32"  ? crc32($data)
              : die("unknown algorithm: $algo (sha256|sha1|md5|crc32)")
            "$algo: $digest"
        })
}

## Read a single environment variable (read-only; "(unset)" when absent).
fn Mcpd::Tools::env_get {
    Mcpd::Schema::tool("env_get", "Read an environment variable by name",
        +{ name => "string" },
        fn {
            val $args = shift
            $ENV{ $args->{name} } // "(unset)"
        })
}

## Current time: Unix epoch seconds plus a local-time string.
fn Mcpd::Tools::time_now {
    Mcpd::Schema::tool("time_now", "Current time (Unix epoch seconds + local string)",
        +{},
        fn {
            val $t = time()
            "epoch: $t\nlocal: " . scalar(localtime($t))
        })
}

## Read the last N lines of a file under $root — the tail of a log. Readonly.
fn Mcpd::Tools::fs_tail ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_tail", "Read the last N lines of a file under $root",
        +{ path => "string", lines => "number" },
        fn {
            val $args = shift
            val $n = int($args->{lines})
            die "lines must be positive" if $n <= 0
            val @lines = split(/\n/, slurp(Mcpd::Tools::jail($root, $args->{path})))
            val $start = scalar(@lines) > $n ? scalar(@lines) - $n : 0
            $start > $#lines ? "" : join("\n", @lines[$start .. $#lines])
        })
}

## Report whether a path exists under $root and, if so, its type. Readonly.
fn Mcpd::Tools::fs_exists ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_exists", "Report whether a path exists under $root and its type",
        +{ path => "string" },
        fn {
            val $args = shift
            val $p = Mcpd::Tools::jail($root, $args->{path})
            unless (-e $p) {
                return "missing"
            }
            val $type = -d $p ? "dir" : -l $p ? "link" : "file"
            $type
        })
}

## Count lines, words and bytes of a file under $root (wc). Readonly.
fn Mcpd::Tools::fs_lines ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_lines", "Count lines, words and bytes of a file under $root",
        +{ path => "string" },
        fn {
            val $args = shift
            val $text  = slurp(Mcpd::Tools::jail($root, $args->{path}))
            val $bytes = length($text)
            val $lines = $text eq "" ? 0 : scalar(split(/\n/, $text, -1)) - 1
            val @words = grep { length $_ } split(/\s+/, $text)
            "lines: $lines\nwords: " . scalar(@words) . "\nbytes: $bytes"
        })
}

## Append text to a file under $root, creating it if absent. Mutating.
fn Mcpd::Tools::fs_append ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_append", "Append text to a file under $root (created if absent)",
        +{ path => "string", content => "string" },
        fn {
            val $args = shift
            val $dest = Mcpd::Tools::jail($root, $args->{path})
            val $existing = -e $dest ? slurp($dest) : ""
            spurt($dest, $existing . $args->{content})
            "appended " . length($args->{content}) . " bytes to $args->{path}"
        })
}

## Copy a file from `src` to `dst`, both resolved under $root (so neither can
## escape the jail). Dies if the source is missing. Mutating.
fn Mcpd::Tools::fs_copy ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_copy", "Copy a file from `src` to `dst`, both under $root",
        +{ src => "string", dst => "string" },
        fn {
            val $args = shift
            val $from = Mcpd::Tools::jail($root, $args->{src})
            val $to   = Mcpd::Tools::jail($root, $args->{dst})
            die "fs_copy: source `$args->{src}` does not exist" unless -e $from
            val $data = slurp($from)
            spurt($to, $data)
            "copied " . length($data) . " bytes from $args->{src} to $args->{dst}"
        })
}

## Move (rename) a file from `src` to `dst`, both resolved under $root (so
## neither can escape the jail). Dies if the source is missing. Falls back to
## copy-then-remove when `rename` can't cross a filesystem boundary. The relocate
## companion to `fs_copy`. Mutating.
fn Mcpd::Tools::fs_move ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_move", "Move/rename a file from `src` to `dst`, both under $root",
        +{ src => "string", dst => "string" },
        fn {
            val $args = shift
            val $from = Mcpd::Tools::jail($root, $args->{src})
            val $to   = Mcpd::Tools::jail($root, $args->{dst})
            die "fs_move: source `$args->{src}` does not exist" unless -e $from
            unless (rename($from, $to)) {
                # Cross-device fallback: copy the bytes, then remove the original.
                spurt($to, slurp($from))
                unlink($from) or die "fs_move: copied but could not remove `$args->{src}`"
            }
            "moved $args->{src} to $args->{dst}"
        })
}

## Create a directory under $root (no-op if it already exists). Mutating.
fn Mcpd::Tools::fs_mkdir ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_mkdir", "Create a directory under $root",
        +{ path => "string" },
        fn {
            val $args = shift
            val $dir = Mcpd::Tools::jail($root, $args->{path})
            return "exists: $args->{path}" if -d $dir
            mkdir($dir) or die "mkdir failed: $args->{path}"
            "created $args->{path}"
        })
}

## Create an empty file, or update an existing file's mtime to now (the touch(1)
## semantics) under $root. Mutating; never truncates existing content.
fn Mcpd::Tools::fs_touch ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_touch", "Create an empty file or update its mtime under $root",
        +{ path => "string" },
        fn {
            val $args = shift
            val $file = Mcpd::Tools::jail($root, $args->{path})
            die "is a directory: $args->{path}" if -d $file
            if (-e $file) {
                val $now = time()
                utime($now, $now, $file) or die "touch failed: $args->{path}"
                return "touched $args->{path}"
            }
            spurt($file, "")
            "created $args->{path}"
        })
}

fn Mcpd::Tools::fs_rmdir ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_rmdir", "Remove an empty directory under $root",
        +{ path => "string" },
        fn {
            val $args = shift
            val $dir = Mcpd::Tools::jail($root, $args->{path})
            return "missing: $args->{path}" unless -d $dir
            rmdir($dir) or die "rmdir failed (not empty?): $args->{path}"
            "removed $args->{path}"
        })
}

fn Mcpd::Tools::fs_delete ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_delete", "Delete a file under $root (use fs_rmdir for directories)",
        +{ path => "string" },
        fn {
            val $args = shift
            val $file = Mcpd::Tools::jail($root, $args->{path})
            return "missing: $args->{path}" unless -e $file
            die "is a directory (use fs_rmdir): $args->{path}" if -d $file
            unlink($file) or die "delete failed: $args->{path}"
            "deleted $args->{path}"
        })
}

fn Mcpd::Tools::all ($opts = undef) {
    $opts //= +{}
    var @pack = (
        Mcpd::Tools::fs_read($opts),
        Mcpd::Tools::fs_list($opts),
        Mcpd::Tools::fs_grep($opts),
        Mcpd::Tools::fs_find($opts),
        Mcpd::Tools::fs_stat($opts),
        Mcpd::Tools::fs_du($opts),
        Mcpd::Tools::fs_head($opts),
        Mcpd::Tools::fs_tail($opts),
        Mcpd::Tools::fs_slice($opts),
        Mcpd::Tools::fs_hash($opts),
        Mcpd::Tools::fs_exists($opts),
        Mcpd::Tools::fs_lines($opts),
        Mcpd::Tools::env_get(),
        Mcpd::Tools::time_now(),
    )
    unless ($opts->{readonly}) {
        push @pack, Mcpd::Tools::fs_write($opts)
        push @pack, Mcpd::Tools::fs_append($opts)
        push @pack, Mcpd::Tools::fs_mkdir($opts)
        push @pack, Mcpd::Tools::fs_touch($opts)
        push @pack, Mcpd::Tools::fs_rmdir($opts)
        push @pack, Mcpd::Tools::fs_delete($opts)
        push @pack, Mcpd::Tools::fs_copy($opts)
        push @pack, Mcpd::Tools::fs_move($opts)
        push @pack, Mcpd::Tools::sh_exec($opts)
    }
    push @pack, Mcpd::Tools::sys_info()
    \@pack
}

## All stock tool names this sublib ships (full, non-readonly pack).
fn Mcpd::Tools::names {
    qw(fs_read fs_list fs_grep fs_find fs_stat fs_du fs_head fs_tail fs_slice fs_hash fs_exists
       fs_lines env_get time_now fs_write fs_append fs_mkdir fs_touch fs_rmdir fs_delete fs_copy fs_move sh_exec sys_info)
}
