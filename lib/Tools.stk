## lib/Tools.stk — `use Mcpd::Tools`
##
## The stock tool pack: filesystem read/list/grep/find/stat/write,
## shell exec, and system info as ready-made specs. Every generator
## takes an opts hashref and returns a spec consumable by
## `Mcpd::Server::serve` — compose your server from stock + custom
## tools in one list. `all(+{readonly => 1})` drops the mutating
## tools (fs_write, sh_exec).
##
## Filesystem tools are root-jailed: paths resolve under opts root
## (default cwd) and escapes (`..`, absolute paths outside root) die —
## which the Server wrap turns into an ERROR result, not a dead server.

package Mcpd::Tools

## Resolve PATH under ROOT and die if the result escapes it.
fn Mcpd::Tools::jail ($root, $path) {
    val $abs = $path =~ m{^/} ? $path : "$root/$path"
    # Lexical normalize: collapse //, resolve . and .. segments.
    var @out
    for my $seg (grep { length $_ && $_ ne "." } split "/", $abs) {
        if ($seg eq "..") {
            die "path escapes root: $path" unless @out
            pop @out
        } else {
            push @out, $seg
        }
    }
    val $norm = "/" . join("/", @out)
    val $jail = $root =~ m{^/} ? $root : "/" . $root
    unless ($norm eq $jail || index($norm, "$jail/") == 0) {
        die "path escapes root: $path"
    }
    $norm
}

## fs_read: return a file's contents. opts: root (jail, default cwd).
fn Mcpd::Tools::fs_read ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_read", "Read a file under $root",
        +{ path => "string" },
        sub {
            val $args = shift
            slurp Mcpd::Tools::jail($root, $args->{path})
        })
}

## fs_list: list a directory. opts: root (jail, default cwd).
fn Mcpd::Tools::fs_list ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_list", "List a directory under $root",
        +{ path => "string" },
        sub {
            val $args = shift
            val $dir = Mcpd::Tools::jail($root, $args->{path})
            die "cannot open dir: $dir" unless -d $dir
            # glob, not opendir: lexical dirhandles read empty inside
            # closures (strykelang bug, see BUGS.md upstream).
            val @entries = sort
                map  { basename($_) }
                grep { val $b = basename($_); $b ne "." && $b ne ".." }
                (glob("$dir/.*"), glob("$dir/*"))
            join("\n", @entries)
        })
}

## fs_grep: regex search a file, return matching lines. opts: root.
fn Mcpd::Tools::fs_grep ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_grep", "Regex-search a file under $root, return matching lines",
        +{ path => "string", pattern => "string" },
        sub {
            val $args = shift
            # No qr// here: a qr object built from a hashref-derived
            # string inside a closure mismatches (strykelang bug, see
            # BUGS.md upstream). Direct /$pat/ interpolation works.
            val $pat = $args->{pattern}
            val @lines = split "\n", slurp(Mcpd::Tools::jail($root, $args->{path}))
            join("\n", grep { /$pat/ } @lines)
        })
}

## fs_write: write content to a file under the jail. opts: root.
## Returns a byte-count receipt. Excluded from `all` in readonly mode.
fn Mcpd::Tools::fs_write ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_write", "Write a file under $root",
        +{ path => "string", content => "string" },
        sub {
            val $args = shift
            val $dest = Mcpd::Tools::jail($root, $args->{path})
            spurt($dest, $args->{content})
            "wrote " . length($args->{content}) . " bytes to $args->{path}"
        })
}

## fs_stat: type / size / mtime for a path under the jail. opts: root.
fn Mcpd::Tools::fs_stat ($opts = undef) {
    $opts //= +{}
    val $root = $opts->{root} // getcwd()
    Mcpd::Schema::tool("fs_stat", "Stat a path under $root: type, size, mtime",
        +{ path => "string" },
        sub {
            val $args = shift
            val $p = Mcpd::Tools::jail($root, $args->{path})
            die "no such path: $args->{path}" unless -e $p
            val @st = stat($p)
            val $type = -d $p ? "dir" : -l $p ? "link" : "file"
            "type: $type\nsize: $st[7]\nmtime: $st[9]"
        })
}

## fs_find: recursive filename search under a jailed directory.
## Params: path (start dir), pattern (regex on the path relative to
## the start dir). opts: root, max_depth (default 10), max_results
## (default 1000) — both caps keep a runaway query from flooding the
## envelope.
fn Mcpd::Tools::fs_find ($opts = undef) {
    $opts //= +{}
    val $root  = $opts->{root} // getcwd()
    val $depth = $opts->{max_depth} // 10
    val $cap   = $opts->{max_results} // 1000
    Mcpd::Schema::tool("fs_find", "Recursively find files under $root whose relative path matches a regex",
        +{ path => "string", pattern => "string" },
        sub {
            val $args = shift
            val $start = Mcpd::Tools::jail($root, $args->{path})
            die "not a directory: $args->{path}" unless -d $start
            # Direct /$pat/ interpolation, not qr// — see fs_grep note.
            val $pat = $args->{pattern}
            var @hits
            var @queue = ([$start, 0])
            while (@queue && @hits < $cap) {
                val $item = shift @queue
                val ($dir, $d) = @$item
                # glob, not opendir — see fs_list note.
                for my $full (sort (glob("$dir/.*"), glob("$dir/*"))) {
                    val $b = basename($full)
                    next if $b eq "." || $b eq ".."
                    val $rel = substr($full, length($start) + 1)
                    push @hits, $rel if $rel =~ /$pat/
                    last if @hits >= $cap
                    push @queue, [$full, $d + 1] if -d $full && !-l $full && $d + 1 < $depth
                }
            }
            join("\n", @hits)
        })
}

## sh_exec: run a shell command, return its output. opts: allow — an
## arrayref of permitted command words; omitted means any command.
fn Mcpd::Tools::sh_exec ($opts = undef) {
    $opts //= +{}
    val $allow = $opts->{allow}
    Mcpd::Schema::tool("sh_exec", "Run a shell command and return its output",
        +{ command => "string" },
        sub {
            val $args = shift
            val $cmd  = $args->{command}
            if (defined $allow) {
                val ($word) = $cmd =~ /^\s*(\S+)/
                val %ok = map { $_ => 1 } @$allow
                die "command `" . ($word // "") . "` not in allowlist" unless $ok{ $word // "" }
            }
            scalar qx($cmd)
        })
}

## sys_info: report platform basics — no params.
fn Mcpd::Tools::sys_info {
    Mcpd::Schema::tool("sys_info", "Report hostname, OS, and stryke version",
        +{},
        sub {
            "host: "   . (hostname_str() // "?") . "\n" .
            "os: $^O\n" .
            "pid: $$\n" .
            "cwd: " . getcwd()
        })
}

## The full stock pack as one list. opts forwarded to each generator.
## opts readonly => 1 drops the mutating tools (fs_write, sh_exec) —
## the safe default for servers that only need to answer questions.
fn Mcpd::Tools::all ($opts = undef) {
    $opts //= +{}
    var @pack = (
        Mcpd::Tools::fs_read($opts),
        Mcpd::Tools::fs_list($opts),
        Mcpd::Tools::fs_grep($opts),
        Mcpd::Tools::fs_find($opts),
        Mcpd::Tools::fs_stat($opts),
    )
    unless ($opts->{readonly}) {
        push @pack, Mcpd::Tools::fs_write($opts)
        push @pack, Mcpd::Tools::sh_exec($opts)
    }
    push @pack, Mcpd::Tools::sys_info()
    \@pack
}

## All stock tool names this sublib ships (full, non-readonly pack).
fn Mcpd::Tools::names { qw(fs_read fs_list fs_grep fs_find fs_stat fs_write sh_exec sys_info) }
