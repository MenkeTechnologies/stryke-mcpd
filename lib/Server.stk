## lib/Server.stk — `use Mcpd::Server`
##
## Validated serving with crash isolation. Two rules of stdio MCP
## servers, both enforced here:
##
##   1. stdout belongs to the protocol — anything else corrupts the
##      JSON-RPC stream. Diagnostics go to a log file via `log_to`.
##   2. a dying tool must not kill the server — every run coderef is
##      wrapped so a die comes back to the client as an ERROR result
##      instead of an EOF.

package Mcpd::Server

use Mcpd::Schema

# mysync: shared mutable across closures (stryke captures by value).
mysync $Mcpd::Server::log_path = undef

## Route server diagnostics to PATH (appended, one line per event).
## Never log to stdout — it carries the JSON-RPC stream.
fn Mcpd::Server::log_to ($path) { $Mcpd::Server::log_path = $path }

## Append MSG to the configured log file. No-op when `log_to` was
## never called. Timestamped, newline-terminated.
fn Mcpd::Server::log ($msg) {
    return unless defined $Mcpd::Server::log_path
    open(my $fh, ">>", $Mcpd::Server::log_path) or return
    print $fh time() . " $msg\n"
    close($fh)
}

## Wrap a run coderef in an error envelope: a die inside the tool
## returns "ERROR: <message>" to the client; the server keeps serving.
## Failures are logged when `log_to` is configured. The stryke/Perl die
## location (" at FILE line N.") is stripped so the client — often an LLM
## — sees just the message, not the server's internal file paths.
fn Mcpd::Server::wrap ($name, $run) {
    fn {
        val $r = eval { $run->(@_) }
        if ($@) {
            var $e = $@ =~ s/\n+$//r
            $e =~ s/ at \S+ line \d+\.?$//
            Mcpd::Server::log("tool $name failed: $e")
            return "ERROR: $e"
        }
        $r
    }
}

## Validate every spec, wrap every run coderef, then hand the set to
## `mcp_server_start` and serve the stdio transport. Blocks for the
## life of the server — call it last.
fn Mcpd::Server::serve ($name, $tools) {
    Mcpd::Schema::validate_all($tools)
    val $wrapped = Mcpd::Server::wrap_all($tools)
    Mcpd::Server::log("serving `$name` with " . scalar(@$wrapped) . " tools")
    mcp_server_start($name, +{ tools => $wrapped })
}

## The configured log path, or undef when `log_to` was never called.
fn Mcpd::Server::log_path { $Mcpd::Server::log_path }

## Return a copy of \@tools with every run coderef wrapped in the
## error envelope; the spec metadata (name, description, parameters)
## is preserved. Pure: builds new specs, never serves.
## NB the four spec keys are listed explicitly rather than splatting
## the source hash — both `+{ %$t, run => ... }` and the
## list-assignment `(%$t, run => ...)` drop keys on a Schema::tool spec
## (strykelang BUG-305).
fn Mcpd::Server::wrap_all ($tools) {
    var @out
    for val $t (@$tools) {
        push @out, +{
            name        => $t->{name},
            description => $t->{description},
            parameters  => $t->{parameters},
            run         => Mcpd::Server::wrap($t->{name}, $t->{run}),
        }
    }
    \@out
}

## Wrap a run coderef so successful calls are logged too (an audit
## trail), in addition to the error envelope `wrap` provides. The log
## line records the tool name and the result's length.
fn Mcpd::Server::audit ($name, $run) {
    val $wrapped = Mcpd::Server::wrap($name, $run)
    fn {
        val $r = $wrapped->(@_)
        Mcpd::Server::log("tool $name ok: " . length("$r") . " bytes")
        $r
    }
}

## Build a spec whose run coderef checks its args against the spec's declared
## parameters (`Mcpd::Schema::check_args`) before the real body runs — a
## missing or mistyped argument dies with a named diagnostic, which `wrap`
## then turns into an ERROR envelope rather than letting a half-validated
## call reach the body. The arg-checked companion of `Schema::tool`.
fn Mcpd::Server::checked ($spec) {
    val $run = $spec->{run}
    +{
        name        => $spec->{name},
        description => $spec->{description},
        parameters  => $spec->{parameters},
        run         => fn {
            val $args = shift
            Mcpd::Schema::check_args($spec, $args)
            $run->($args)
        },
    }
}

## Return a copy of \@tools with every run coderef arg-checked (`checked`)
## AND error-wrapped (`wrap`) — the strict serving variant of `wrap_all`.
## Use it when every tool should reject malformed arguments at the door
## instead of inside its body.
fn Mcpd::Server::wrap_all_checked ($tools) {
    Mcpd::Schema::validate_all($tools)
    var @out
    for val $t (@$tools) {
        val $c = Mcpd::Server::checked($t)
        push @out, +{
            name        => $c->{name},
            description => $c->{description},
            parameters  => $c->{parameters},
            run         => Mcpd::Server::wrap($c->{name}, $c->{run}),
        }
    }
    \@out
}
