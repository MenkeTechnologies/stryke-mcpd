## lib/Client.stk — `use Mcpd::Client`
##
## Result-envelope helpers for the client side. `mcp_connect`,
## `mcp_tools`, `mcp_call`, `mcp_close` are stryke builtins — none
## re-wrapped here. What this sublib adds is the part everyone writes
## by hand: unpacking the MCP result envelope
## (`+{content => [+{type => "text", text => ...}, ...]}`) and the
## call-then-unpack composite that round-trip tests live on.

package Mcpd::Client

## Extract and join the text blocks from an MCP call result. Returns
## "" for results with no text content.
fn Mcpd::Client::text ($result) {
    return "" unless ref($result) eq "HASH" && ref($result->{content}) eq "ARRAY"
    join("", map { $_->{text} // "" } grep { ($_->{type} // "") eq "text" } @{ $result->{content} })
}

## `mcp_call` + `text` in one step — the round-trip primitive.
fn Mcpd::Client::call_text ($h, $name, $args) {
    Mcpd::Client::text(mcp_call($h, $name, $args // +{}))
}

## True when the result is an Mcpd error envelope (a tool that died
## behind `Mcpd::Server::wrap`).
fn Mcpd::Client::is_error ($result) {
    index(Mcpd::Client::text($result), "ERROR: ") == 0 ? 1 : 0
}

## Tool names a connected server exposes, sorted.
fn Mcpd::Client::tool_names ($h) {
    [ sort map { $_->{name} } @{ mcp_tools($h) } ]
}

## Every text block as a list (unjoined), in envelope order. Empty
## list when there's no text content. Use when blocks are logically
## separate (one per row, per file, …) rather than one concatenated body.
fn Mcpd::Client::texts ($result) {
    return [] unless ref($result) eq "HASH" && ref($result->{content}) eq "ARRAY"
    [ map { $_->{text} // "" } grep { ($_->{type} // "") eq "text" } @{ $result->{content} } ]
}

## The distinct content-block types present in the result, sorted
## (e.g. ["image","text"]). Empty list for an empty/blockless result.
fn Mcpd::Client::content_types ($result) {
    return [] unless ref($result) eq "HASH" && ref($result->{content}) eq "ARRAY"
    var %seen
    [ sort grep { !$seen{$_}++ } map { $_->{type} // "" } @{ $result->{content} } ]
}

## All content blocks of a given $type from a tool result, as a list of the
## block hashrefs — so image blocks keep their data/mimeType, resource blocks
## their resource, and so on. The general form of `texts` (which is the
## text-only special case). Empty list for an empty/blockless result.
fn Mcpd::Client::content_of_type ($result, $type) {
    return [] unless ref($result) eq "HASH" && ref($result->{content}) eq "ARRAY"
    [ grep { ($_->{type} // "") eq $type } @{ $result->{content} } ]
}

## The error text WITHOUT the "ERROR: " prefix, or undef when the
## result is not an error envelope. Pairs with `is_error`.
fn Mcpd::Client::error_message ($result) {
    return undef unless Mcpd::Client::is_error($result)
    substr(Mcpd::Client::text($result), length("ERROR: "))
}

## True if a connected server exposes a tool named $name.
fn Mcpd::Client::has_tool ($h, $name) {
    val %ok = map { $_ => 1 } @{ Mcpd::Client::tool_names($h) }
    $ok{$name} ? 1 : 0
}

## The JSON `inputSchema` of the tool named $name on a connected server, or
## undef when no such tool is exposed. Pairs with has_tool/tool_names: once a
## tool is known to exist, this is how you introspect the arguments it accepts
## (its JSON Schema, as the server advertises it over `tools/list`).
fn Mcpd::Client::tool_schema ($h, $name) {
    for val $t (@{ mcp_tools($h) }) {
        return $t->{inputSchema} if ($t->{name} // "") eq $name
    }
    undef
}

## How many tools a connected server exposes. The scalar companion of
## `tool_names` — for a one-line "connected: N tools" status without
## materializing the name list.
fn Mcpd::Client::tool_count ($h) {
    scalar @{ mcp_tools($h) }
}

## A { name => description } map of every tool a connected server exposes —
## the catalog a client renders in a tool picker. Tools that advertise no
## description map to "".
fn Mcpd::Client::tool_descriptions ($h) {
    var %map
    for val $t (@{ mcp_tools($h) }) {
        $map{ $t->{name} } = $t->{description} // ""
    }
    \%map
}

## The joined text of a call result split into lines (newline-separated),
## as a list. Empty list for an empty result. The line-oriented companion
## of `text` — for results that are naturally a list of rows (a directory
## listing, grep hits, `wc` output) without the caller re-splitting.
fn Mcpd::Client::text_lines ($result) {
    val $body = Mcpd::Client::text($result)
    return [] if $body eq ""
    [ split(/\n/, $body) ]
}

## The number of content blocks in a result (of every type), or 0 for an
## empty/blockless result. The count companion of `texts`/`content_of_type`.
fn Mcpd::Client::block_count ($result) {
    return 0 unless ref($result) eq "HASH" && ref($result->{content}) eq "ARRAY"
    scalar @{ $result->{content} }
}

## `mcp_call` + `text_lines` in one step — the line-oriented round-trip
## primitive. For a tool whose result is naturally a list of rows (a directory
## listing, grep hits, `wc` output): call it and get back the lines as a list,
## without the caller re-splitting `call_text`.
fn Mcpd::Client::call_lines ($h, $name, $args) {
    Mcpd::Client::text_lines(mcp_call($h, $name, $args // +{}))
}

## `mcp_call` + `texts` in one step — the multi-block round-trip primitive.
## Returns every text block as a list (unjoined), in envelope order, for a tool
## that emits logically separate text blocks (one per row/file) rather than one
## concatenated body. The unjoined companion of `call_text`.
fn Mcpd::Client::call_texts ($h, $name, $args) {
    Mcpd::Client::texts(mcp_call($h, $name, $args // +{}))
}
